{
  "manifest_version": 3,
  "name": "Meet Transcript",
  "version": "0.6.0",
  "description": "Transkrip Google Meet & rekam panggilan Discord web dari caption/audio (STT API atau server lokal), jadi Minutes of Meeting.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "storage", "unlimitedStorage", "tabCapture", "offscreen", "activeTab", "contextMenus", "scripting"],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://discord.com/*",
    "https://api.openai.com/*",
    "https://gemini.google.com/*",
    "https://chatgpt.com/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "commands": {
    "rec-start": { "suggested_key": { "default": "Alt+Shift+R" }, "description": "Rekam audio meeting" },
    "rec-start-video": { "suggested_key": { "default": "Alt+Shift+V" }, "description": "Rekam audio + video meeting" },
    "rec-stop": { "suggested_key": { "default": "Alt+Shift+S" }, "description": "Stop rekam" }
  },
  "background": { "service_worker": "background/service-worker.js" },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content/selectors.js", "content/session.js", "content/captions.js", "content/captionhide.js", "content/captionlang.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": { "default_path": "panel/panel.html" },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Meet Transcript",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  }
}
