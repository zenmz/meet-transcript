{
  "manifest_version": 3,
  "name": "Meet Transcript",
  "version": "0.5.1",
  "description": "Transkrip Google Meet dari caption dan rekaman audio/video (STT via API atau server lokal), lalu jadi Minutes of Meeting.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "storage", "unlimitedStorage", "tabCapture", "offscreen", "activeTab", "contextMenus", "scripting"],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://api.openai.com/*",
    "https://gemini.google.com/*",
    "https://chatgpt.com/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background/service-worker.js" },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content/selectors.js", "content/session.js", "content/captions.js", "content/captionhide.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    { "resources": ["icons/icon48.png"], "matches": ["https://meet.google.com/*"] }
  ],
  "side_panel": { "default_path": "panel/panel.html" },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Meet Transcript",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  }
}
