{
  "manifest_version": 3,
  "name": "Meet Transcript",
  "version": "0.7.0",
  "description": "Transkrip Google Meet & rekam panggilan Discord/Zoom web dari caption/audio (STT API atau server lokal), jadi Minutes of Meeting.",
  "browser_specific_settings": {
    "gecko": {
      "id": "meet-transcript@zenmz",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "permissions": ["storage", "unlimitedStorage", "activeTab", "contextMenus", "scripting"],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://api.openai.com/*",
    "https://gemini.google.com/*",
    "https://chatgpt.com/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "scripts": ["lib/merge.js", "lib/openai.js", "lib/stt.js", "lib/audiostore.js", "background/service-worker.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content/selectors.js", "content/session.js", "content/captions.js", "content/captionhide.js", "content/captionlang.js"],
      "run_at": "document_idle"
    }
  ],
  "sidebar_action": {
    "default_panel": "panel/panel.html",
    "default_title": "Meet Transcript",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
    "open_at_install": false
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Meet Transcript",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  }
}
